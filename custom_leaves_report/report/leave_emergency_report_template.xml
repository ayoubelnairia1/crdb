<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="leave_emergency_report_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style type="text/css">
                    @font-face {
                    font-family: 'al-mohanad';
                    src: url('/custom_leaves_report/static/src/fonts/al-mohanad.ttf') format('truetype');
                    font-weight: normal;
                    font-style: normal;
                    }
                    .al-mohanad-arabic {
                    font-family: 'al-mohanad', Arial, sans-serif !important;
                    direction: rtl;
                    margin-top: 0mm;
                    }
                    @page {
                    margin: 0;
                    }
                    .section-title {
                    font-weight: bold;
                    }
                    .main-border {
                    margin-top: 0;
                    padding-top: 0;
                    border: 0px solid #222;
                    border-radius: 1px;
                    <!--  padding: 0px 12px 12px 12px;
                      margin: 0 auto; -->
                    max-width: 1000px;
                    <!--         box-sizing: border-box;  -->
                    background: #fff;
                    }
                    .report-header {
                    text-align: center;
                    margin-top: 0px;
                    margin-bottom: 8px;
                    }
                    .report-header img {
                    max-height: 60px;
                    margin-bottom: 4px;
                    }
                    .section {
                    border: 1px solid #999;
                    border-radius: 14px;
                    margin-bottom: 10px;
                    padding: 8px 100px 8px 5px;
                    background: #fff;
                    }
                    .section-title {
                    font-weight: bold;
                    font-size: 18px;
                    margin-bottom: 4px;
                    }
                    .section-content {
                    font-size: 15px;
                    padding: 8px 100px 8px 5px;
                    text-align: right;
                    line-height: 2.1;
                    }
                    .label {
                    font-weight: bold;
                    }
                    .dotted {
                    border-bottom: 1px dotted #888;
                    min-width: 120px;
                    display: inline-block;
                    height: 1.1em;
                    vertical-align: middle;
                    margin: 0 3px;
                    }
                </style>
                <div class="al-mohanad-arabic main-border" style="margin-top:0; padding-top:0;">
                    <div class="report-header">
                        <img src="/custom_leaves_report/static/src/img/logo.png"/>
                        <div style="font-size: 26px; font-weight: bold;">جهاز تنمية وتطوير المنطقة الوسطى</div>
                        <div style="font-size: 21px;">إدارة الشؤون الإدارية والخدمات</div>
                        <div style="font-size: 21px; font-weight: bold;">نموذج إجازة طارئة</div>
                    </div>
                    <!-- Section 1 -->
                    <div class="section">
                        <div class="section-title">القسم الأول: بيانات الموظف طالب الإجازة:</div>
                        <div class="section-content">
                            <span class="label">الاسم:</span>
                            <span t-esc="docs.employee_id.name"/>
                            <br></br>
                            <span class="label">الوظيفة:</span>
                            <span t-esc="docs.employee_id.job_id.name or ''"/>
                            <br/>
                            <span class="label">الدرجة:</span>
                            <span class="dotted"></span>
                            <br/>
                            <span class="label">القسم:</span>
                            <span t-esc="docs.employee_id.department_id.name or ''"/>
                            <br/>
                            <span class="label">مدة الإجازة المطلوبة:</span>
                            <span class="dotted" style="width:70px"></span>
                            <br/>
                            <span class="label">ابتداءً من تاريخ:</span>
                            <span t-esc="docs.request_date_from"/> &#160;&#160;&#160;&#160;
                            <span class="label">حتى تاريخ:</span>
                            <span t-esc="docs.request_date_to"/>
                            <br/>
                            <span class="label">نوع الإجازة:</span>
                            <span t-esc="docs.holiday_status_id.name or ''"/>
                            <br/>
                            <span class="label">تاريخ تقديم الطلب:</span>
                            <span t-esc="docs.request_date_from"/>
                        </div>
                    </div>
                    <!-- Section 2 -->
                    <div class="section">
                        <div class="section-title">
                            <t t-set="o" t-value="docs[0]"/>

                            <b>القسم الثاني: بيانات قسم شؤون الموظفين:</b>
                        </div>
                        <div class="section-content">
                            مجموع الإجازة المستحقة عن السنة: <span class="dotted"></span> أيام
                            <br/>
                            - استخدم الإجازة الطارئة: <span class="dotted"></span> أيام
                            <br/>
                            مجموع الإجازة الطارئة المتبقية عن السنة : <span class="dotted"></span> أيام
                            <br/>
                            التاريخ: <span class="dotted" style="width:70px"></span> / <span class="dotted"
                                                                                             style="width:70px"></span> /

                            <br/>
                            التوقيع:
                            <span class="dotted" style="width:180px"></span>
                        </div>
                    </div>
                    <!-- Section 3 -->
                    <div class="section">
                        <div class="section-title">القسم الثالث: رأي الرئيس المباشر:</div>
                        <div class="section-content">
                            .............................................................................
                            <br/>
                            الوظيفة / قسم الملاحظات:
                            <span class="dotted" style="width:180px"></span>
                            <br/>
                            التوقيع:
                            <span class="dotted" style="width:180px"></span>
                        </div>
                    </div>
                    <!-- Section 4 -->
                    <div class="section">
                        <div class="section-title">القسم الرابع: رأي الرئيس الأعلى:</div>
                        <div class="section-content">
                            ......................................................
                            <br/>
                            الوظيفة / قسم الملاحظات:
                            <span class="dotted" style="width:180px"></span>
                            <br/>
                            التوقيع:
                            <span class="dotted" style="width:180px"></span>
                        </div>
                    </div>
                    <!-- Note Section -->
                    <div class="section">
                        <div class="section-title">ملاحظة:</div>
                        <div class="section-content">
                            .............................................................................
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>