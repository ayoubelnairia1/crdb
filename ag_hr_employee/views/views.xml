<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_inherit" model="ir.ui.view">
            <field name="name">view_employee_form_inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='identification_id']" position="after">
                    <field name="family_paper_number"/>
                    <field name="family_registration_number"/>
                </xpath>

                <xpath expr="//field[@name='country_id']" position="after">
                    <field name="mother_name"/>
                </xpath>

                <xpath expr="//field[@name='certificate']/.." position="after">
                    <group string="Certificates">
                        <field name="certificate_info_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="certification_level"/>
                                <field name="organization"/>
                                <field name="graduation_date"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
                <xpath expr="//field[@name='certificate']" position="after">
                    <field name="job_grade"/>
                    <field name="experience_years"/>
                </xpath>

                <xpath expr="//field[@name='work_location_id']" position="after">
                    <field name="job_transfer_process"/>
                </xpath>

                <xpath expr="//field[@name='address_id']" position="after">
                    <field name="employee_number"/>
                    <field name="financial_number"/>
                    <field name="functional_structure_number"/>
                    <field name="social_security_number"/>
                    <field name="insurance_number"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
